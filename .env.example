GEMINI_API_KEY=your-gemini-api-key-here
TEACHER_PASSWORD=your-teacher-dashboard-password-here

# Optional: real-time incident email alerts from system_service.py (watchdog).
# Requires a Gmail App Password (Google Account -> Security -> 2-Step Verification -> App Passwords),
# not your normal Gmail password. If left unset, the watchdog just skips emailing and logs as before.
ALERT_EMAIL_ADDRESS=your-gmail-address@gmail.com
ALERT_EMAIL_APP_PASSWORD=your-16-char-app-password

# ------------------------------------------------------------------
# QA 자동 점검 에이전트 (src/qa_agent/). 아무것도 설정하지 않아도 기본값으로 동작한다.
# 아래는 기본값을 바꾸고 싶을 때만 쓰는 선택 항목이다.
# ------------------------------------------------------------------
# QA_AGENT_ENABLED=1              # 0이면 감지 루프와 정기 점검을 아예 띄우지 않음
# QA_AGENT_WATCH_INTERVAL=30      # 실시간 감지 주기(초)
# QA_AGENT_DEBOUNCE=90            # 파일 저장이 멎고 이만큼 지나야 검증 시작(초)
# QA_AGENT_MIN_RERUN=600          # 같은 기능 재검증 최소 간격(초)
# QA_AGENT_NIGHTLY_HOUR=21        # 매일 정기 점검 시각 (기본 21:00)
# QA_AGENT_NIGHTLY_MINUTE=0
# QA_AGENT_DEVICE_ENABLED=1       # 가상 안드로이드 폰(에뮬레이터) 실화면 검증
# QA_AGENT_AVD=passionmate_test   # 사용할 AVD 이름
# QA_AGENT_KEEP_EMULATOR=0        # 1이면 점검 후에도 에뮬레이터를 끄지 않음
# QA_AGENT_JUDGE_ENABLED=1        # Gemini 시각/종합 판정
# QA_AGENT_JUDGE_DAILY_BUDGET=6   # QA가 하루에 쓸 수 있는 Gemini 호출 수(나머지는 학생 챗봇 몫)
# QA_AGENT_ALLOW_WRITES=0         # 1이면 운영 DB에 기록을 남기는 프로브까지 실행(권장하지 않음)
# QA_AGENT_ALERT_ON_FAIL=1        # 점검 실패 시 위 ALERT_EMAIL_* 로 메일

# ------------------------------------------------------------------
# 오늘의 꿀팁 - 유튜브 영상 자동 검색 (선택)
# ------------------------------------------------------------------
# YouTube Data API v3 키. Google Cloud 콘솔에서 YouTube Data API v3를 켜고 발급한다.
# https://console.cloud.google.com/apis/library/youtube.googleapis.com
#
# 이 키가 하는 일은 '영상 검색'뿐이다. **영상 자막을 받아오는 데는 키가 필요 없다**
# (youtube-transcript-api 사용). 그래서 키가 없어도:
#   - 선생님이 대시보드에서 직접 등록한 영상은 자막 분석까지 정상 동작하고
#   - 매일 새 영상을 자동으로 찾아오는 기능만 꺼진다.
# 무료 할당량은 하루 10,000 유닛이고 검색 1회가 100 유닛이라 하루 100회까지 쓸 수 있다.
# 이 앱은 하루 최대 3회만 검색한다.
# YOUTUBE_API_KEY=your-youtube-data-api-v3-key
