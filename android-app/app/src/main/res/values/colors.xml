<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- public/manifest.json의 theme_color / background_color와 맞춘다.
         학생 화면 기본값이 Oura 다크라 네이티브 배경도 같은 캔버스 색으로 둔다.
         (흰색으로 두면 앱 기동 때 흰 화면이 한 번 번쩍인다)
         앱 안에서 화이트로 전환해도 기동 화면은 기본값을 따르므로 여기는 다크로 고정한다. -->
    <color name="app_background">#0A0B0D</color>
    <color name="app_on_background">#F4F1EA</color>
    <color name="app_muted">#8B8985</color>
</resources>
